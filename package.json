{
  "name": "jellyquest-tizen",
  "version": "1.0.6",
  "description": "Household streaming and requesting client for Samsung Smart TV (Tizen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicklongmore86/jellyquest-tizen.git"
  },
  "scripts": {
    "build": "npm run build:overlay && gulp && npm run configure",
    "build:overlay": "node scripts/build-overlay.mjs",
    "configure": "node scripts/configure-jellyquest.mjs",
    "build:full": "bash scripts/build.sh",
    "package:wgt": "bash scripts/package-wgt.sh",
    "install:tv": "bash scripts/install-tv.sh",
    "preview:tv": "bash scripts/preview-tv.sh",
    "postinstall": "node scripts/postinstall.mjs",
    "lint": "eslint .",
    "test": "node --test test/configuration.test.mjs",
    "test:e2e": "npm run build:overlay && node --test \"test/e2e/**/*.spec.mjs\""
  },
  "devDependencies": {
    "@babel/preset-env": "7.25.7",
    "@babel/register": "7.25.7",
    "@eslint/js": "10.0.1",
    "del": "8.0.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "gulp": "5.0.0",
    "gulp-dom": "1.0.0",
    "gulp-if": "3.0.0",
    "gulp-scan": "0.1.4",
    "playwright": "1.56.1"
  },
  "type": "module",
  "dependencies": {
    "spatial-navigation-polyfill": "1.3.1"
  }
}
